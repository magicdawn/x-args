{
  "name": "@magicdawn/x-args",
  "type": "module",
  "version": "3.3.1",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "description": "play with cli commands like a composer",
  "author": "magicdawn",
  "license": "MIT",
  "homepage": "https://github.com/magicdawn/x-args#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/magicdawn/x-args.git"
  },
  "bugs": {
    "url": "https://github.com/magicdawn/x-args/issues"
  },
  "keywords": [
    "x-args",
    "xargs",
    "args-composer",
    "args-manipulator"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "x-args": "./dist/bin.js",
    "x-args-bun": "./exe/x-args-bun"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "bin": {
      "x-args": "./dist/bin.js"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint src",
    "check": "conc pnpm:lint pnpm:typecheck",
    "build": "pnpm check && tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "mocha",
    "test-cover": "nyc --reporter=lcov --reporter=text mocha",
    "report-cover": "codecov",
    "build:watch": "rm -rf lib; tsgo -d -w",
    "build:bun-exe": "bun build --format esm --compile --bytecode --minify --sourcemap --outfile ./exe/x-args-bun ./src/bin.ts && rm -f ./.*.bun-build"
  },
  "peerDependencies": {
    "clipanion": "^4.0.0-rc.4"
  },
  "dependencies": {
    "better-result": "^3.0.1",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "chokidar": "^6.0.0",
    "emittery": "^2.2.0",
    "env-paths": "^4.0.0",
    "es-toolkit": "^1.52.0",
    "execa": "^10.2.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "log-symbols": "^7.0.1",
    "mac-helper": "^0.12.0",
    "ms": "^2.1.3",
    "needle-kit": "^3.8.0",
    "obug": "^3.0.0",
    "p-queue": "^10.0.0",
    "proper-lockfile": "^4.1.2",
    "shlex": "^3.0.0",
    "siginfo": "^2.0.0",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@magicdawn/eslint-config": "^1.6.18",
    "@magicdawn/prettier-config": "^0.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "^10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "prettier": "^3.9.10",
    "should": "^13.2.3",
    "tsdown": "^0.23.1",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts,jsx,tsx,json,md,yaml,yml}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
