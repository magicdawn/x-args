{
  "include": ["./src/**/*", "eslint.config.js", "tsdown.config.ts"],
  "compilerOptions": {
    "paths": {
      "$*": ["./src/*"]
    },
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true
  }
}
